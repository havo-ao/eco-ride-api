{
  "name": "eco-ride-api",
  "version": "1.0.0",
  "description": "API backend para EcoRide - Node.js + TypeScript + MySQL + MongoDB + Kafka",
  "main": "dist/server.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "migrate": "ts-node scripts/migrate.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"add eslint later\"",
    "test": "jest",
    "test:unit": "jest --config jest.unit.config.js",
    "test:integration": "jest --config jest.integration.config.js",
    "test:ci": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/havo-ao/eco-ride-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/havo-ao/eco-ride-api/issues"
  },
  "homepage": "https://github.com/havo-ao/eco-ride-api#readme",
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "2.8.5",
    "stripe": "12.0.0",
    "dotenv": "17.2.3",
    "express": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.19.2",
    "mysql2": "3.15.3",
    "nodemailer": "7.0.10",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.1",
    "tsconfig-paths": "4.2.0"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/mongoose": "5.11.96",
    "@types/node": "24.9.1",
    "@types/nodemailer": "7.0.3",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "nodemon": "3.1.10",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
